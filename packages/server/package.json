    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cwd ../database db:generate"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.11",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/provider-utils": "^4.0.27",
    "@clerk/backend": "^3.5.0",
    "@hono/zod-validator": "^0.8.0",
    "@nyxcode/database": "workspace:*",
    "@nyxcode/shared": "workspace:*",
    "@polar-sh/sdk": "^0.48.0",
    "@sentry/bun": "^10.55.0",
    "@sentry/hono": "^10.55.0",
    "ai": "^6.0.194",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.2",
    "typescript": "^5.9.3"
  }
}
